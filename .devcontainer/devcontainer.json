{
  "name": "Next.js Dev",
  "dockerComposeFile": "compose.yml",
  "service": "nextjs",
  "workspaceFolder": "/workspace",
  "updateRemoteUserUID": true,
  "remoteUser": "appuser",
  "remoteEnv": {
    "NEXT_TELEMETRY_DISABLED": "1",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "onCreateCommand": {
    "setup-git": "git config --global user.name \"$GIT_USER_NAME\" && git config --global user.email \"$GIT_USER_EMAIL\""
  },
  "postCreateCommand": "chmod +x .devcontainer/entrypoint.sh && .devcontainer/entrypoint.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.defaultFormatter": "biomejs.biome",
        "editor.codeActionsOnSave": {
          "source.fixAll.biome": "explicit",
          "source.organizeImports.biome": "explicit"
        },
        "editor.indentSize": 2,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.formatOnSave": true,
        "biome.lsp.bin": "/workspace/app/node_modules/.bin/biome",
        "biome.requireConfiguration": true,
        "biome.configurationPath": "/workspace/app/biome.json",
        "biome.lsp.trace.server": "off"
      },
      "extensions": [
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "eamodio.gitlens",
        "shardulm94.trailing-spaces",
        "usernamehw.errorlens",
        "mikestead.dotenv"
      ]
    }
  },
  "forwardPorts": [3000, 3001, 8787],
  "portsAttributes": {
    "3000": {
      "label": "Next.js",
      "onAutoForward": "notify"
    },
    "3001": {
      "label": "vinext",
      "onAutoForward": "silent"
    },
    "8787": {
      "label": "Wrangler",
      "onAutoForward": "silent"
    }
  }
}
